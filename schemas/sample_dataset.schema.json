{
  "schema_name": "generic-sample-record-v1",
  "dataset_id": "synthetic-generic-example-v1",
  "allow_unexpected_fields": false,
  "fields": {
    "record_id": {
      "type": "string",
      "required": true,
      "nullable": false,
      "allow_empty_string": false
    },
    "observed_at": {
      "type": "string",
      "required": true,
      "nullable": false,
      "allow_empty_string": false
    },
    "value": {
      "type": "float",
      "required": true,
      "nullable": false
    },
    "unit": {
      "type": "string",
      "required": true,
      "nullable": false,
      "allow_empty_string": false
    },
    "category": {
      "type": "string",
      "required": false,
      "nullable": false,
      "allow_empty_string": false
    },
    "notes": {
      "type": "string",
      "required": false,
      "nullable": false,
      "allow_empty_string": false
    }
  },
  "duplicate_detection": {
    "enabled": true,
    "strategy": "fields",
    "fields": ["record_id"]
  }
}
